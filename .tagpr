# tagpr の設定（#149）。リリース PR を作り、マージされたらタグを打つ。
# 流れは .claude/skills/release/SKILL.md、設計の理由は CLAUDE.md の「リリース PR（tagpr）」。
[tagpr]
	releaseBranch = main
	vPrefix = true
	# 版は tagpr が 2 つのファイルに書く（各ファイルで今の版の文字列の最初の 1 か所）。
	# Cargo.lock は tagpr が触らないので、postVersionCommand が `--cargo src-tauri` で合わせる
	# （#154。Cargo.toml の [package] の版が提案と違えば、そこで落ちる）
	versionFile = src-tauri/tauri.conf.json,src-tauri/Cargo.toml
	postVersionCommand = node scripts/release-prepare.mjs
	# CHANGELOG は各 PR が `## [Unreleased]` に書く。tagpr の生成（PR タイトルの列挙）は使わない
	changelog = false
	# リリースは release.yml の draft ジョブが作る。Immutable releases なので、
	# tagpr が公開まで進めると成果物を足せなくなる
	release = false
	# 機能の PR は issue と同じ enhancement のラベルで minor に上げる。無ければ patch
	minorLabels = enhancement
