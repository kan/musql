{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muSQL",
  "version": "0.1.0",
  "identifier": "dev.kan.musql",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "muSQL",
        "width": 740,
        "height": 760,
        "resizable": true,
        "maximizable": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "muSQL Settings",
        "url": "settings.html",
        "width": 920,
        "height": 760,
        "visible": false,
        "resizable": true,
        "maximizable": false
      },
      {
        "label": "query",
        "title": "muSQL Query",
        "url": "query.html",
        "width": 980,
        "height": 820,
        "visible": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
