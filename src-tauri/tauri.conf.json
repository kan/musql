{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muSQL",
  "version": "0.5.3",
  "identifier": "jp.co.communitylinks.musql",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "muSQL",
        "width": 740,
        "height": 760,
        "resizable": true,
        "maximizable": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "muSQL Settings",
        "url": "settings.html",
        "width": 640,
        "height": 820,
        "visible": false,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "query",
        "title": "muSQL Query",
        "url": "query.html",
        "width": 1200,
        "height": 820,
        "visible": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3MENGNEU1NDJCQkJFQTEKUldTaHZydEM1ZlFNcDhDUTY0MFZkZmMzNXVSOHg4YVc5Wmo0Z092MnlTYjM5WnlQcCtsYU04LzMK",
      "endpoints": [
        "https://github.com/kan/musql/releases/latest/download/latest.json"
      ]
    }
  }
}
