{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muSQL",
  "version": "0.1.0",
  "identifier": "dev.kan.musql",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "muSQL",
        "width": 740,
        "height": 760,
        "resizable": true,
        "maximizable": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "muSQL Settings",
        "url": "settings.html",
        "width": 920,
        "height": 760,
        "visible": false,
        "resizable": true,
        "maximizable": false
      },
      {
        "label": "query",
        "title": "muSQL Query",
        "url": "query.html",
        "width": 1200,
        "height": 820,
        "visible": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MUYyMzVDQkZBOTYzQkQKUldTOVk2bS9YQ01mMmJ1UXFocW53UEMxRXpxd0ZNWHpGUG5aRjJQV3lrQ0VnNGtISjhScE9xRDgK",
      "endpoints": [
        "https://github.com/kan/musql/releases/latest/download/latest.json"
      ]
    }
  }
}
